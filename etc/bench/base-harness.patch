+[package]
+name = "nf-replay-bench"
+description = "Replays a needlefish .nfrp archive through base/base's stateless block executor"
+edition.workspace = true
+license.workspace = true
+version.workspace = true
+publish = false
+
+[dependencies]
+base-proof-executor = { workspace = true, features = ["std"] }
+base-proof-mpt = { workspace = true, features = ["std"] }
+base-common-evm = { workspace = true, features = ["std"] }
+base-common-chains = { workspace = true, features = ["std"] }
+base-common-genesis = { workspace = true, features = ["std"] }
+base-common-rpc-types-engine = { workspace = true, features = ["std"] }
+alloy-rpc-types-engine = { workspace = true, features = ["std"] }
+# The crypto backends base/base's node (`base-reth-node`) builds with: C libsecp256k1 for
+# sender recovery and ECRECOVER, blst, c-kzg and aws-lc P256. The proof executor alone
+# would build pure-Rust k256 and arkworks instead.
+alloy-consensus = { workspace = true, features = ["std", "secp256k1"] }
+alloy-primitives = { workspace = true, features = ["std"] }
+alloy-rlp = { workspace = true, features = ["std"] }
